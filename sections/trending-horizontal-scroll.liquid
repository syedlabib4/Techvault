{{ 'section-trending-horizontal.css' | asset_url | stylesheet_tag }}

<section
  id="trending-products-{{ section.id }}"
  class="trending-products"
  style="
    --section-bg: {{ section.settings.background_color }};
    --card-bg: {{ section.settings.card_background }};
    --card-gap: {{ section.settings.card_gap }}px;
    --card-radius: {{ section.settings.card_radius }}px;
    --card-padding: {{ section.settings.card_padding }}px;
    --image-height: {{ section.settings.image_height }}px;
    --title-color: {{ section.settings.product_title_color }};
    --price-color: {{ section.settings.price_color }};
    --curtain-color: {{ section.settings.curtain_color }};
    --curtain-text: {{ section.settings.curtain_text_color }};
    --curtain-speed: {{ section.settings.animation_duration }}s;
  "
>

  <div class="trending-products__container">

    <!-- =========================================
         PRODUCTS
    ========================================== -->

    <div class="trending-products__grid">

      {% if section.settings.collection != blank %}

        {% for product in section.settings.collection.products limit: 4 %}

          <article class="trending-product-card">

            <a
              href="{{ product.url }}"
              class="trending-product-card__link"
            >

              <div class="trending-product-card__image">

                {% if product.featured_image != blank %}

                  <img
                    src="{{ product.featured_image | image_url: width: 900 }}"
                    srcset="
                      {{ product.featured_image | image_url: width: 500 }} 500w,
                      {{ product.featured_image | image_url: width: 700 }} 700w,
                      {{ product.featured_image | image_url: width: 900 }} 900w
                    "
                    sizes="(max-width: 749px) 90vw, 25vw"
                    alt="{{ product.featured_image.alt | default: product.title | escape }}"
                    loading="lazy"
                    width="{{ product.featured_image.width }}"
                    height="{{ product.featured_image.height }}"
                  >

                {% else %}

                  {{ 'product-1' | placeholder_svg_tag: 'placeholder-svg' }}

                {% endif %}


                {% if section.settings.show_view_button %}

                  <span class="trending-product-card__view">
                    View Product
                  </span>

                {% endif %}

              </div>


              <div class="trending-product-card__content">

                <h3 class="trending-product-card__title">
                  {{ product.title }}
                </h3>

                <div class="trending-product-card__price">
                  {{ product.price | money }}
                </div>

              </div>

            </a>

          </article>

        {% endfor %}

      {% else %}

        {% for i in (1..4) %}

          <article class="trending-product-card">

            <div class="trending-product-card__image">
              {{ 'product-1' | placeholder_svg_tag: 'placeholder-svg' }}
            </div>

            <div class="trending-product-card__content">

              <h3 class="trending-product-card__title">
                Product {{ i }}
              </h3>

              <div class="trending-product-card__price">
                $0.00
              </div>

            </div>

          </article>

        {% endfor %}

      {% endif %}

    </div>


    <!-- =========================================
         CURTAIN
    ========================================== -->

    {% if section.settings.enable_animation %}

      <div class="trending-curtain" aria-hidden="true">

        <div class="trending-curtain__left"></div>

        <div class="trending-curtain__right"></div>


        <div class="trending-curtain__text">

          {% if section.settings.eyebrow != blank %}

            <span class="trending-curtain__eyebrow">
              {{ section.settings.eyebrow }}
            </span>

          {% endif %}


          <h2>
            {{ section.settings.heading }}
          </h2>


          {% if section.settings.subheading != blank %}

            <p>
              {{ section.settings.subheading }}
            </p>

          {% endif %}

        </div>


        <div class="trending-curtain__center-line"></div>

      </div>

    {% endif %}

  </div>

</section>


<script>
(function () {

  function initTrendingCurtain() {

    const section = document.getElementById(
      'trending-products-{{ section.id }}'
    );

    if (!section) return;

    if (section.dataset.trendingInitialized === 'true') {
      return;
    }

    section.dataset.trendingInitialized = 'true';


    {% if section.settings.enable_animation %}

      let hasPlayed = false;


      function checkSectionPosition() {

        if (hasPlayed) return;


        const rect = section.getBoundingClientRect();

        const triggerPoint = window.innerHeight * 0.72;


        /*
          Animation starts when the TOP of the section
          reaches approximately 72% of the viewport.

          This makes it happen naturally while scrolling
          DOWN toward the section.
        */

        if (rect.top <= triggerPoint && rect.bottom > 0) {

          hasPlayed = true;

          section.classList.add(
            'trending-products--revealed'
          );

          window.removeEventListener(
            'scroll',
            checkSectionPosition
          );

        }

      }


      /*
        Check once after page load.
      */

      requestAnimationFrame(function () {

        checkSectionPosition();

      });


      /*
        Watch normal page scrolling.
      */

      window.addEventListener(
        'scroll',
        checkSectionPosition,
        {
          passive: true
        }
      );


      /*
        Also check after resize.
      */

      window.addEventListener(
        'resize',
        checkSectionPosition,
        {
          passive: true
        }
      );

    {% else %}

      section.classList.add(
        'trending-products--revealed'
      );

    {% endif %}

  }


  /*
    Normal storefront
  */

  if (document.readyState === 'loading') {

    document.addEventListener(
      'DOMContentLoaded',
      initTrendingCurtain
    );

  } else {

    initTrendingCurtain();

  }


  /*
    Shopify Theme Editor
  */

  document.addEventListener(
    'shopify:section:load',
    function (event) {

      if (
        event.detail &&
        event.detail.sectionId ===
        '{{ section.id }}'
      ) {

        initTrendingCurtain();

      }

    }
  );

})();
</script>


{% schema %}

{
  "name": "Trending Products",

  "settings": [

    {
      "type": "header",
      "content": "Products"
    },

    {
      "type": "collection",
      "id": "collection",
      "label": "Select collection"
    },


    {
      "type": "header",
      "content": "Curtain"
    },

    {
      "type": "checkbox",
      "id": "enable_animation",
      "label": "Enable curtain animation",
      "default": true
    },

    {
      "type": "text",
      "id": "eyebrow",
      "label": "Small text",
      "default": "DISCOVER"
    },

    {
      "type": "text",
      "id": "heading",
      "label": "Heading",
      "default": "TRENDING PRODUCTS"
    },

    {
      "type": "textarea",
      "id": "subheading",
      "label": "Subheading",
      "default": "Explore what's trending right now."
    },

    {
      "type": "range",
      "id": "animation_duration",
      "min": 0.6,
      "max": 2.5,
      "step": 0.1,
      "unit": "s",
      "label": "Curtain speed",
      "default": 1.2
    },


    {
      "type": "header",
      "content": "Product Cards"
    },

    {
      "type": "range",
      "id": "card_gap",
      "min": 10,
      "max": 50,
      "step": 2,
      "unit": "px",
      "label": "Card spacing",
      "default": 24
    },

    {
      "type": "range",
      "id": "card_padding",
      "min": 6,
      "max": 24,
      "step": 2,
      "unit": "px",
      "label": "Card padding",
      "default": 12
    },

    {
      "type": "range",
      "id": "card_radius",
      "min": 8,
      "max": 36,
      "step": 2,
      "unit": "px",
      "label": "Card radius",
      "default": 20
    },

    {
      "type": "range",
      "id": "image_height",
      "min": 250,
      "max": 500,
      "step": 10,
      "unit": "px",
      "label": "Image height",
      "default": 360
    },


    {
      "type": "header",
      "content": "Colors"
    },

    {
      "type": "color",
      "id": "background_color",
      "label": "Section background",
      "default": "#F6F7F9"
    },

    {
      "type": "color",
      "id": "card_background",
      "label": "Card background",
      "default": "#FFFFFF"
    },

    {
      "type": "color",
      "id": "product_title_color",
      "label": "Product title",
      "default": "#222222"
    },

    {
      "type": "color",
      "id": "price_color",
      "label": "Price",
      "default": "#666666"
    },

    {
      "type": "color",
      "id": "curtain_color",
      "label": "Curtain color",
      "default": "#111111"
    },

    {
      "type": "color",
      "id": "curtain_text_color",
      "label": "Curtain text color",
      "default": "#FFFFFF"
    },


    {
      "type": "header",
      "content": "Product Interaction"
    },

    {
      "type": "checkbox",
      "id": "show_view_button",
      "label": "Show View Product on hover",
      "default": true
    }

  ],

  "presets": [
    {
      "name": "Trending Products"
    }
  ]

}

{% endschema %}