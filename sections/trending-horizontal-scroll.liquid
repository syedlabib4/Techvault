      "content": "Animation"
    },
    {
      "type": "range",
      "id": "animation_duration",
      "min": 2,
      "max": 8,
      "step": 0.5,
      "unit": "s",
      "label": "Horizontal animation",
      "default": 4
    },
    {
      "type": "range",
      "id": "pin_duration",
      "min": 1800,
      "max": 6000,
      "step": 100,
      "unit": "px",
      "label": "Scroll distance",
      "default": 3600
    },
    {
      "type": "range",
      "id": "scrub",
      "min": 0.1,
      "max": 2,
      "step": 0.1,
      "label": "Scroll smoothness",
      "default": 0.8
    },
    {
      "type": "range",
      "id": "heading_exit_distance",
      "min": 50,
      "max": 250,
      "step": 10,
      "unit": "px",
      "label": "Heading exit distance",
      "default": 110
    },

    {
      "type": "header",
      "content": "Extra UI"
    },
    {
      "type": "checkbox",
      "id": "show_view_label",
      "label": "Show 'View product' on hover",
      "default": true
    },
    {
      "type": "checkbox",
      "id": "show_scroll_hint",
      "label": "Show scroll hint",
      "default": true
    },
    {
      "type": "text",
      "id": "scroll_hint",
      "label": "Scroll hint text",
      "default": "SCROLL TO EXPLORE"
    },
    {
      "type": "checkbox",
      "id": "show_progress",
      "label": "Show scroll progress",
      "default": true
    }
  ],
  "presets": [
    {
      "name": "Trending Horizontal"
    }
  ]
}
{% endschema %}