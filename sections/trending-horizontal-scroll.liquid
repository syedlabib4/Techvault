{{ 'section-trending-horizontal.css' | asset_url | stylesheet_tag }}

<section
  id="trending-products-{{ section.id }}"
  class="trending-products"
  style="
    --section-bg: {{ section.settings.background_color }};
    --card-bg: {{ section.settings.card_background }};
    --card-radius: {{ section.settings.card_radius }}px;
    --card-gap: {{ section.settings.card_gap }}px;
    --card-padding: {{ section.settings.card_padding }}px;
    --image-height: {{ section.settings.image_height }}px;
    --title-color: {{ section.settings.title_color }};
    --product-title-color: {{ section.settings.product_title_color }};
    --price-color: {{ section.settings.price_color }};
    --accent-color: {{ section.settings.accent_color }};
    --shadow-opacity: {{ section.settings.shadow_opacity | divided_by: 100.0 }};
  "
>

  <div class="trending-products__container">

    {% if section.settings.show_heading %}
      <div class="trending-products__header">

        {% if section.settings.eyebrow != blank %}
          <span class="trending-products__eyebrow">
            {{ section.settings.eyebrow }}
          </span>
        {% endif %}

        <h2 class="trending-products__heading">
          {{ section.settings.heading }}
        </h2>

        {% if section.settings.subheading != blank %}
          <p class="trending-products__subheading">
            {{ section.settings.subheading }}
          </p>
        {% endif %}

      </div>
    {% endif %}


    <div class="trending-products__grid">

      {% if section.settings.collection != blank %}

        {% for product in section.settings.collection.products limit: 4 %}

          <article class="trending-product-card">

            <a
              href="{{ product.url }}"
              class="trending-product-card__link"
            >

              <div class="trending-product-card__image">

                {% if product.featured_image != blank %}

                  <img
                    src="{{ product.featured_image | image_url: width: 900 }}"
                    srcset="
                      {{ product.featured_image | image_url: width: 500 }} 500w,
                      {{ product.featured_image | image_url: width: 700 }} 700w,
                      {{ product.featured_image | image_url: width: 900 }} 900w
                    "
                    sizes="(max-width: 749px) 88vw, 25vw"
                    alt="{{ product.featured_image.alt | default: product.title | escape }}"
                    loading="lazy"
                    width="{{ product.featured_image.width }}"
                    height="{{ product.featured_image.height }}"
                  >

                {% else %}

                  {{ 'product-1' | placeholder_svg_tag: 'placeholder-svg' }}

                {% endif %}

                {% if section.settings.show_view_button %}

                  <span class="trending-product-card__view">
                    View Product
                  </span>

                {% endif %}

              </div>


              <div class="trending-product-card__content">

                <h3 class="trending-product-card__title">
                  {{ product.title }}
                </h3>

                <div class="trending-product-card__price">
                  {{ product.price | money }}
                </div>

              </div>

            </a>

          </article>

        {% endfor %}

      {% else %}

        {% for i in (1..4) %}

          <article class="trending-product-card">

            <div class="trending-product-card__image">
              {{ 'product-apparel-1' | placeholder_svg_tag: 'placeholder-svg' }}
            </div>

            <div class="trending-product-card__content">

              <h3 class="trending-product-card__title">
                Product {{ i }}
              </h3>

              <div class="trending-product-card__price">
                $0.00
              </div>

            </div>

          </article>

        {% endfor %}

      {% endif %}

    </div>

  </div>

</section>


{% schema %}

{
  "name": "Trending Products",

  "settings": [

    {
      "type": "header",
      "content": "Content"
    },

    {
      "type": "checkbox",
      "id": "show_heading",
      "label": "Show heading",
      "default": true
    },

    {
      "type": "text",
      "id": "eyebrow",
      "label": "Eyebrow",
      "default": "DISCOVER"
    },

    {
      "type": "text",
      "id": "heading",
      "label": "Heading",
      "default": "TRENDING PRODUCTS"
    },

    {
      "type": "textarea",
      "id": "subheading",
      "label": "Subheading",
      "default": "Explore our most popular products."
    },

    {
      "type": "collection",
      "id": "collection",
      "label": "Product collection"
    },


    {
      "type": "header",
      "content": "Card Layout"
    },

    {
      "type": "range",
      "id": "card_gap",
      "min": 10,
      "max": 50,
      "step": 2,
      "unit": "px",
      "label": "Card spacing",
      "default": 24
    },

    {
      "type": "range",
      "id": "card_padding",
      "min": 6,
      "max": 24,
      "step": 2,
      "unit": "px",
      "label": "Card padding",
      "default": 12
    },

    {
      "type": "range",
      "id": "card_radius",
      "min": 8,
      "max": 36,
      "step": 2,
      "unit": "px",
      "label": "Card radius",
      "default": 20
    },

    {
      "type": "range",
      "id": "image_height",
      "min": 250,
      "max": 500,
      "step": 10,
      "unit": "px",
      "label": "Image height",
      "default": 360
    },


    {
      "type": "header",
      "content": "Colors"
    },

    {
      "type": "color",
      "id": "background_color",
      "label": "Section background",
      "default": "#F7F8FA"
    },

    {
      "type": "color",
      "id": "card_background",
      "label": "Card background",
      "default": "#FFFFFF"
    },

    {
      "type": "color",
      "id": "title_color",
      "label": "Heading color",
      "default": "#111111"
    },

    {
      "type": "color",
      "id": "product_title_color",
      "label": "Product title",
      "default": "#222222"
    },

    {
      "type": "color",
      "id": "price_color",
      "label": "Price color",
      "default": "#666666"
    },

    {
      "type": "color",
      "id": "accent_color",
      "label": "Accent color",
      "default": "#111111"
    },

    {
      "type": "range",
      "id": "shadow_opacity",
      "min": 0,
      "max": 20,
      "step": 1,
      "unit": "%",
      "label": "Card shadow",
      "default": 5
    },


    {
      "type": "header",
      "content": "Extra"
    },

    {
      "type": "checkbox",
      "id": "show_view_button",
      "label": "Show View Product on hover",
      "default": true
    }

  ],

  "presets": [
    {
      "name": "Trending Products"
    }
  ]

}

{% endschema %}